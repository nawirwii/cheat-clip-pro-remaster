{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cheat Clip Pro",
  "version": "0.0.14",
  "identifier": "com.nawirwii.cheatclippro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [{
      "title": "Cheat Clip Pro",
      "width": 1440,
      "height": 920,
      "minWidth": 1100,
      "minHeight": 700,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/cheat-clip-pro-backend"],
    "resources": ["../backend/fonts", "../backend/cascades"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
